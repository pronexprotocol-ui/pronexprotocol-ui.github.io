rules_version = '2';
// Pronex_Study · regras do Firestore v4 (app 1.17: comunidade só com conta confirmada, grupos privados, sem cópia do tutor nem registo de atividade, suspensões e limites de pontos)
// Documentação: sec/INVENTARIO.md (o que a app escreve) e o cabeçalho de cada bloco.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Base ----------
    function signed() { return request.auth != null; }
    function me(u) { return signed() && request.auth.uid == u; }
    function isAdmin() {
      return signed()
        && request.auth.token.get('email', '') == 'pronex.protocol@gmail.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Conta verdadeira: não anónima e com o email confirmado (nas contas Google já vem confirmado).
    function naoAnonimo() { return signed() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function conta() { return naoAnonimo() && request.auth.token.get('email_verified', false) == true; }
    // Aceitou os termos e declarou ter 13 anos ou mais.
    function aceitou() {
      return get(/databases/$(database)/documents/consent/$(request.auth.uid)).data.get('idade13', false) == true;
    }
    // Pode escrever na comunidade.
    function ativo() { return conta() && aceitou() && !banido(); }

    // Até esta data, as regras aceitam também as escritas da app 1.7 (sem lote de ritmo,
    // sem motivo nas denúncias, sem xpIni/streakEm no perfil, sem criadoEm no registo).
    // Depois desta data, só o formato 1.8 passa. Muda a data se a 1.8 sair mais tarde.
    function legado() { return request.time < timestamp.date(2026, 11, 25); }

    function d() { return request.resource.data; }
    function old() { return resource.data; }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isInt(v, min, max) { return v is int && v >= min && v <= max; }
    function changed(k) { return request.resource.data.get(k, null) != resource.data.get(k, null); }
    function kept(k) { return !changed(k); }
    // Datas em milissegundos (Date.now()) escritas pela app: nunca no futuro (5 min de folga
    // para relógios adiantados) e, quando 'antiga' > 0, não mais antigas do que isso.
    function msNow() { return request.time.toMillis(); }
    function msOk(v, antigaMin) {
      return v is int && v <= msNow() + 300000
        && (antigaMin == 0 || v >= msNow() - antigaMin * 60000);
    }
    function img(v, max) {
      return v is string && v.size() <= max
        && (v.size() == 0 || v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }
    function uidStr(v) { return isStr(v, 1, 128); }
    function idStr(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function dia(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // ---------- Banidos ----------
    // bans/{uid}, com data de fim opcional em 'ate'; bansEmail/{email}, para a suspensão definitiva
    // não se contornar com outra conta no mesmo email; ou perfis/{uid}.banned == true.
    function banido() {
      let b = /databases/$(database)/documents/bans/$(request.auth.uid);
      let e = /databases/$(database)/documents/bansEmail/$(request.auth.token.email);
      return (exists(b) && (get(b).data.get('ate', null) == null || get(b).data.ate > request.time))
        || (exists(e) && (get(e).data.get('ate', null) == null || get(e).data.ate > request.time))
        || (exists(/databases/$(database)/documents/perfis/$(request.auth.uid))
            && get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.get('banned', false) == true);
    }

    // ---------- Limite de ritmo ----------
    // O cliente escreve, no MESMO lote (writeBatch), o conteúdo novo e
    // utilizadores/{uid}.<campo> = serverTimestamp(). Passa se a escrita anterior
    // (ou, sem nenhuma, a criação do registo) tiver sido há >= seg segundos.
    function ritmoOk(campo, seg) {
      let u = /databases/$(database)/documents/utilizadores/$(request.auth.uid);
      return exists(u)
        && getAfter(u).data.get(campo, null) == request.time
        && (get(u).data.get(campo, null) != null
              ? get(u).data[campo] + duration.value(seg, 's') <= request.time
              : (get(u).data.get('criadoEm', null) == null
                 || get(u).data.criadoEm + duration.value(seg, 's') <= request.time));
    }
    function ritmo(campo, seg) { return ritmoOk(campo, seg) || legado(); }

    // ---------- Administrador ----------
    match /bans/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if isAdmin()
        && d().keys().hasOnly(['motivo', 'por', 'em', 'ate'])
        && isStr(d().get('motivo', ''), 0, 200)
        && (d().get('ate', null) == null || d().ate is timestamp)
        && d().por == request.auth.uid && d().em == request.time;
      allow delete: if isAdmin();
    }
    match /bansEmail/{email} {
      allow get: if isAdmin() || (conta() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && d().keys().hasOnly(['motivo', 'por', 'em', 'ate'])
        && isStr(d().get('motivo', ''), 0, 200)
        && (d().get('ate', null) == null || d().ate is timestamp)
        && d().por == request.auth.uid && d().em == request.time;
      allow delete: if isAdmin();
    }

    // Registo de ações do administrador: só se acrescenta, nunca se muda nem apaga.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && d().keys().hasOnly(['acao', 'alvo', 'detalhe', 'por', 'em'])
        && d().keys().hasAll(['acao', 'por', 'em'])
        && isStr(d().acao, 1, 60)
        && isStr(d().get('alvo', ''), 0, 120)
        && isStr(d().get('detalhe', ''), 0, 300)
        && d().por == request.auth.uid
        && d().em == request.time;
      allow update, delete: if false;
    }

    // Avisos do administrador. Leitura por consulta: where('alvo','in',['todos', uid]).
    match /notifs/{id} {
      allow read: if signed()
        && ((resource.data.alvo == 'todos' && conta()) || resource.data.alvo == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && d().keys().hasOnly(['titulo', 'texto', 'alvo', 'tipo', 'criadoEm', 'por'])
        && d().keys().hasAll(['titulo', 'texto', 'alvo', 'tipo', 'criadoEm', 'por'])
        && isStr(d().titulo, 1, 80)
        && isStr(d().texto, 1, 300)
        && (d().alvo == 'todos' || uidStr(d().alvo))
        && d().tipo in ['aviso', 'versao', 'turma']
        && d().criadoEm == request.time
        && d().por == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Consentimento (termos e idade): o próprio cria e atualiza; o próprio e o admin leem.
    match /consent/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid)
        && d().keys().hasOnly(['versao', 'aceitouEm', 'idade13', 'termos'])
        && d().keys().hasAll(['versao', 'aceitouEm', 'idade13', 'termos'])
        && isStr(d().versao, 1, 10)
        && d().aceitouEm == request.time
        && d().idade13 is bool
        && d().termos is bool;
      allow delete: if me(uid) || isAdmin();
    }

    // ---------- Configuração ----------
    // config/app: ordens de reposição, código da turma (hash) e versão mínima. Todos leem.
    match /config/app {
      allow read: if signed();
      allow write: if isAdmin()
        && d().keys().hasOnly(['reset', 'users', 'por', 'em', 'turmaHash', 'minVersion'])
        && (!('reset' in d()) || d().reset is int)
        && (!('users' in d()) || d().users is map)
        && (!('por' in d()) || isStr(d().por, 0, 254))
        && (!('em' in d()) || isStr(d().em, 0, 40))
        && (!('turmaHash' in d()) || (isStr(d().turmaHash, 0, 64) && d().turmaHash.matches('^([0-9a-fA-F]{64})?$')))
        && (!('minVersion' in d()) || (isStr(d().minVersion, 0, 12) && d().minVersion.matches('^([0-9]+[.][0-9]+[.][0-9]+)?$')));
    }
    // config/ai: já não se usa. Fica fechado para ninguém voltar a guardar lá uma chave.
    match /config/ai {
      allow read, write: if false;
    }
    // config/admin: hash do PIN do painel. Só o administrador.
    match /config/admin {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && d().keys().hasOnly(['pinHash', 'salt', 'atualizado'])
        && isStr(d().pinHash, 1, 128)
        && isStr(d().get('salt', ''), 0, 64)
        && (d().atualizado is int || d().atualizado is float);
    }
    // config/ligas: grupos da semana e resultados. Escrito só pela tarefa automática (.github/pronex/ligas.mjs).
    match /config/ligas {
      allow read: if conta();
      allow write: if false;
    }
    // Qualquer outro documento de config: só o administrador.
    match /config/{outro} {
      allow read, write: if isAdmin() && !(outro in ['app', 'ai', 'admin', 'ligas']);
    }

    // Prémios da semana (moedas e medalhas). Escritos só pela tarefa automática; o próprio pode apagar os seus.
    match /premios/{uid} {
      allow read: if me(uid) || conta();
      allow create, update: if false;
      allow delete: if me(uid) || isAdmin();
    }

    // ---------- Dados privados de cada utilizador ----------
    // data/users/{uid}/dia_AAAA-MM-DD | dia_0000-anteriores | notifs_lidas | push | bloqueios
    // Os antigos log_AAAA-MM-DD e tutor já não se podem escrever; só apagar.
    match /data/users/{uid}/{doc} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid) && docOk(doc);
      allow delete: if me(uid) || isAdmin();

      function docOk(nome) {
        return (nome.matches('^dia_([0-9]{4}-[0-9]{2}-[0-9]{2}|0000-anteriores)$')
                  && d().keys().hasOnly(['date', 'goal', 'items'])
                  && d().date == nome.split('_')[1]
                  && (!('goal' in d()) || isInt(d().goal, 0, 1000))
                  && d().items is list && d().items.size() <= 400)
          || (nome == 'notifs_lidas'
                  && d().keys().hasOnly(['ids', 'upd'])
                  && d().ids is list && d().ids.size() <= 300
                  && d().upd == request.time)
          // Tokens do Firebase Cloud Messaging: um por dispositivo, no máximo 6.
          || (nome == 'push'
                  && d().keys().hasOnly(['toks', 'upd'])
                  && d().toks is map && d().toks.size() <= 6
                  && d().upd == request.time)
          // Pessoas que este utilizador bloqueou.
          || (nome == 'bloqueios'
                  && d().keys().hasOnly(['ids', 'upd'])
                  && d().ids is list && d().ids.size() <= 200
                  && d().upd == request.time)
          // Carteira (1.21): moedas gastas, baús abertos, prémios de duelos e compras da loja.
          // O que se gastou nunca desce e os baús e prémios já recebidos não se apagam.
          || (nome == 'loja'
                  && d().keys().hasOnly(['gasto', 'baus', 'duelos', 'own', 'cores', 'skin', 'top', 'frz', 'upd'])
                  && isInt(d().gasto, 0, 1000000)
                  && d().baus is map && d().baus.size() <= 12
                  && d().duelos is map && d().duelos.size() <= 1000
                  && d().own is list && d().own.size() <= 20
                  && d().cores is list && d().cores.size() <= 12
                  && d().skin is string && d().skin.size() <= 20
                  && d().top is list && d().top.size() <= 3
                  && d().frz is map && d().frz.keys().hasOnly(['have', 'used', 'lastKey'])
                  && isInt(d().frz.get('have', 0), 0, 3)
                  && d().frz.get('used', []) is list && d().frz.get('used', []).size() <= 60
                  && d().upd == request.time
                  && (resource == null
                      || (d().gasto >= resource.data.gasto
                          && d().baus.keys().hasAll(resource.data.baus.keys())
                          && d().duelos.keys().hasAll(resource.data.duelos.keys()))));
      }
    }

    // ---------- Registo de utilizadores e dispositivos ----------
    match /utilizadores/{uid} {
      allow get: if me(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if me(uid) && regOk()
        && (d().get('criadoEm', null) == request.time || (legado() && !('criadoEm' in d())))
        && d().get('ultimoPost', request.time) == request.time
        && d().get('ultimaMsg', request.time) == request.time;
      allow update: if me(uid) && regOk()
        && kept('criadoEm')
        && carimbo('ultimoPost') && carimbo('ultimaMsg');
      allow delete: if me(uid) || isAdmin();

      function regOk() {
        return d().keys().hasOnly(['uid', 'nick', 'email', 'anon', 'ultimo', 'versao', 'dev', 'criado',
                                   'criadoEm', 'turma', 'consent', 'ultimoPost', 'ultimaMsg'])
          && d().uid == uid
          && isStr(d().get('nick', ''), 0, 30)
          && isStr(d().get('email', ''), 0, 254)
          && (d().get('email', '') == '' || d().email == request.auth.token.get('email', ''))
          && d().get('anon', false) is bool
          && msOk(d().get('ultimo', 0), 0)
          && isStr(d().get('versao', ''), 0, 12)
          && d().get('dev', {}) is map && d().get('dev', {}).size() <= 50
          && d().get('criado', 0) is int
          && d().get('turma', false) is bool
          && consentOk(d().get('consent', null));
      }
      function consentOk(c) {
        return c == null
          || (c is map && c.keys().hasOnly(['v', 'em']) && isStr(c.get('v', ''), 0, 10)
              && msOk(c.get('em', 0), 0));
      }
      // Carimbos de ritmo: só podem passar a request.time e nunca desaparecer.
      function carimbo(k) {
        return kept(k)
          || (request.resource.data.get(k, null) == request.time);
      }
    }

    // ---------- Perfil público (ranking) ----------
    // O Firestore só avalia 1000 expressões por pedido: este bloco evita funções auxiliares de propósito.
    match /perfis/{uid} {
      allow read: if me(uid) || conta();
      allow create: if me(uid) && ativo() && perfilOk() && !('banned' in request.resource.data)
        && (isAdmin() || criacaoOk());
      allow update: if (me(uid) && naoAnonimo() && perfilOk()
          && request.resource.data.get('banned', null) == resource.data.get('banned', null)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nick', 'curso', 'escola', 'bio', 'foto', 'top']) || ativo())
          && (isAdmin() || subidaOk()))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
            && request.resource.data.get('banned', false) is bool);
      allow delete: if me(uid) || isAdmin();

      function perfilOk() {
        let r = request.resource.data;
        let foto = r.get('foto', '');
        return r.keys().hasOnly(['nick', 'curso', 'escola', 'bio', 'foto', 'cor', 'goal', 'ranking', 'ai', 'sent',
                                 'xp', 'wxp', 'wk', 'nivel', 'streak', 'total', 'certos', 'badges', 'upd',
                                 'xpIni', 'xpIniEm', 'streakEm', 'banned', 'top', 'mxp', 'mk', 'tx', 'pwk', 'pwxp'])
          && r.keys().hasAll(['nick', 'xp', 'nivel', 'streak'])
          && r.nick is string && r.nick.size() >= 1 && r.nick.size() <= 30
          && r.get('curso', '') is string && r.get('curso', '').size() <= 40
          && r.get('escola', '') is string && r.get('escola', '').size() <= 60
          && r.get('bio', '') is string && r.get('bio', '').size() <= 200
          && foto is string && foto.size() <= 60000
          && (foto == '' || foto.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
          && r.get('cor', 0) >= 0 && r.get('cor', 0) <= 11
          && r.get('goal', 0) <= 100
          && r.get('ranking', true) is bool && r.get('sent', false) is bool
          && r.get('ai', 0) <= 1000000
          && r.xp is int && r.xp >= 0 && r.xp <= 100000000
          && r.get('wxp', 0) >= 0 && r.get('wxp', 0) <= r.xp
          && (!('wk' in r) || r.wk.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && nivelOk(r.nivel, r.xp)
          && r.streak >= 0 && r.streak <= 3650
          && r.get('total', 0) <= 10000000
          && r.get('certos', 0) <= r.get('total', 0)
          && r.get('badges', 0) <= 50
          && (!('top' in r) || (r.top is list && r.top.size() <= 3))
          && r.get('upd', 0) <= request.time.toMillis() + 300000
          && r.get('mxp', 0) <= r.xp
          && (!('mk' in r) || r.mk.matches('^[0-9]{4}-[0-9]{2}$'))
          && (!('tx' in r) || (r.tx.size() <= 3 && r.tx.keys().hasOnly(['Eleições', 'Partilha', 'Finanças'])
                && r.tx.get('Eleições', 0) <= r.xp && r.tx.get('Partilha', 0) <= r.xp && r.tx.get('Finanças', 0) <= r.xp));
      }
      // nivel tem de ser o que levelOf(xp) dá: nível n começa em 100m + 30m(m-1), m = n-1.
      function nivelOk(n, xp) {
        let m = n - 1;
        return n is int && n >= 1 && n <= 2000
          && 100 * m + 30 * m * (m - 1) <= xp
          && xp < 100 * (m + 1) + 30 * (m + 1) * m;
      }
      // Criar: até 250 XP (o máximo de uma sessão real) e sequência 0 ou 1.
      // Na transição, a 1.7 cria com o total que já tem localmente (até 5000 XP).
      function criacaoOk() {
        let r = request.resource.data;
        return (r.xp <= 250 && r.streak <= 1
                && r.get('xpIni', -1) is int && r.get('xpIni', -1) >= 0 && r.xpIni <= r.xp
                && r.get('xpIniEm', null) == request.time
                && (r.streak == 0 || r.get('streakEm', null) == request.time))
          || (legado() && r.xp <= 5000);
      }
      // Atualizar: o XP nunca desce e sobe no máximo 250 por escrita e 5000 por dia (UTC).
      // O XP da semana e do mês sobem ao mesmo ritmo; na semana ou no mês novos, contam de zero.
      // As contagens de exercícios sobem no máximo o que cabe num dia de histórico.
      function subidaOk() {
        let r = request.resource.data;
        let o = resource.data;
        let dx = r.xp - o.get('xp', 0);
        let wk = r.get('wk', '');
        let p = wk.split('-');
        let dw = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
        return dx >= 0 && dx <= 250
          && wk.size() == 10
          && dw > request.time - duration.value(8, 'd')
          && dw < request.time + duration.value(1, 'd')
          && r.get('wxp', 0) - (o.get('wk', '') == wk ? o.get('wxp', 0) : 0) <= 250
          // A semana e o mês nunca andam para trás (um dispositivo ainda no domingo não apaga a semana nova).
          && (!('wk' in o) || wk >= o.wk)
          && (!('mk' in o) || !('mk' in r) || r.mk >= o.mk)
          // Semana anterior (para as ligas): só se copia da semana que acabou, tal como estava.
          && (r.get('pwk', null) == o.get('pwk', null) && r.get('pwxp', null) == o.get('pwxp', null)
              || (o.get('wk', '') < wk && r.get('pwk', null) == o.get('wk', null) && r.get('pwxp', null) == o.get('wxp', 0)))
          && r.get('mxp', 0) - (o.get('mk', '') == r.get('mk', '') ? o.get('mxp', 0) : 0) <= 250
          && r.get('total', 0) - o.get('total', 0) <= 400
          && r.get('certos', 0) - o.get('certos', 0) <= 400
          && sequenciaOk()
          && (diaXpOk() || (legado() && !('xpIniEm' in r)));
      }
      function diaXpOk() {
        let r = request.resource.data;
        let o = resource.data;
        let novoDia = !('xpIniEm' in o) || o.xpIniEm.date() != request.time.date();
        return novoDia
          ? (r.get('xpIni', -1) == o.get('xp', 0) && r.get('xpIniEm', null) == request.time)
          : (r.get('xpIni', null) == o.get('xpIni', null) && r.get('xpIniEm', null) == o.get('xpIniEm', null) && r.xp - r.xpIni <= 5000);
      }
      // Sequência: pode descer (nunca é batota) ou subir 1 uma vez por dia.
      // "Dia" = muda o dia em UTC ou em UTC+1 (cobre o horário de inverno e de verão de Portugal).
      function sequenciaOk() {
        let r = request.resource.data;
        let o = resource.data;
        let s0 = o.get('streak', 0);
        let e0 = o.get('streakEm', null);
        let igualEm = r.get('streakEm', null) == e0;
        return (r.streak <= s0 && igualEm)
          || (r.streak == s0 + 1 && r.get('streakEm', null) == request.time && (e0 == null || outroDia(e0)))
          || (legado() && r.streak == s0 + 1 && igualEm);
      }
      function outroDia(t) {
        return t.date() != request.time.date()
          || (t + duration.value(1, 'h')).date() != (request.time + duration.value(1, 'h')).date();
      }
    }

    // ---------- Mural ----------
    match /posts/{id} {
      allow read: if conta() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if ativo()
        && d().keys().hasOnly(['uid', 'text', 'img', 'ts', 'likes', 'tipo'])
        && d().keys().hasAll(['uid', 'text', 'img', 'ts', 'likes'])
        && d().get('tipo', 'post') in ['post', 'pergunta']
        && d().uid == request.auth.uid
        && isStr(d().text, 0, 1000)
        && img(d().img, 700000)
        && (d().text.size() > 0 || d().img.size() > 0)
        && msOk(d().ts, 1440)
        && d().likes is map && d().likes.size() == 0
        && ritmo('ultimoPost', 10);
      // Gostos: cada um só liga (true) ou desliga o seu próprio gosto.
      // Reações: cada um só põe ou tira a sua, de uma lista fechada.
      // Fixar: só o administrador. Melhor resposta: só o autor de uma pergunta.
      allow update: if (signed()
        && d().diff(old()).affectedKeys().hasOnly(['likes'])
        && d().likes is map
        && d().likes.diff(old().likes).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in d().likes) || (ativo() && d().likes[request.auth.uid] == true)))
        || (signed()
        && d().diff(old()).affectedKeys().hasOnly(['reac'])
        && d().reac is map && d().reac.size() <= 500
        && d().reac.diff(old().get('reac', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in d().reac) || (ativo() && d().reac[request.auth.uid] in ['gosto', 'coracao', 'riso', 'uau', 'fogo'])))
        || (isAdmin() && d().diff(old()).affectedKeys().hasOnly(['pin']) && d().pin is bool)
        || (ativo() && old().uid == request.auth.uid && old().get('tipo', 'post') == 'pergunta'
        && d().diff(old()).affectedKeys().hasOnly(['melhor'])
        && (d().melhor == '' || idStr(d().melhor)));
      allow delete: if signed() && (old().uid == request.auth.uid || isAdmin());

      match /coments/{c} {
        allow read: if conta() || (signed() && get(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid);
        allow create: if ativo()
          && exists(/databases/$(database)/documents/posts/$(id))
          && d().keys().hasOnly(['uid', 'text', 'ts'])
          && d().keys().hasAll(['uid', 'text', 'ts'])
          && d().uid == request.auth.uid
          && isStr(d().text, 1, 500)
          && msOk(d().ts, 1440)
          && ritmo('ultimaMsg', 3);
        allow update: if false;
        // O autor do comentário, o administrador, ou o dono da publicação
        // (a 1.8 apaga os comentários das suas publicações ao apagar a conta).
        allow delete: if signed() && (old().uid == request.auth.uid || isAdmin()
          || (exists(/databases/$(database)/documents/posts/$(id))
              && get(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid));
      }
    }

    // ---------- Conversa por canais (lista fechada de canais) ----------
    function canalGrupo(canal) {
      return canal.matches('^g_[A-Za-z0-9]{6,30}$')
        && exists(/databases/$(database)/documents/grupos/$(canal))
        && get(/databases/$(database)/documents/grupos/$(canal)).data.membros.get(request.auth.uid, false) == true;
    }
    match /canais/{canal}/msgs/{msg} {
      allow read: if (canal in ['geral', 'matematica', 'testes', 'sugestoes'] && conta())
        || (conta() && canalGrupo(canal));
      allow create: if ativo()
        && (canal in ['geral', 'matematica', 'testes', 'sugestoes'] || canalGrupo(canal))
        && d().keys().hasOnly(['uid', 'text', 'ts'])
        && d().keys().hasAll(['uid', 'text', 'ts'])
        && d().uid == request.auth.uid
        && isStr(d().text, 1, 500)
        && msOk(d().ts, 1440)
        && ritmo('ultimaMsg', 3);
      allow update: if false;
      allow delete: if signed() && (old().uid == request.auth.uid || isAdmin());
    }

    // Consultas de grupo para "apagar a minha conta": where('uid','==', uid).
    // Só para encontrar o que é da própria pessoa: uma consulta geral não pode ler grupos alheios.
    match /{caminho=**}/coments/{c} { allow read: if signed() && (resource.data.uid == request.auth.uid || conta()); }
    match /{caminho=**}/msgs/{m} { allow read: if signed() && resource.data.uid == request.auth.uid; }


    // ---------- Grupos de estudo (o canal de conversa é canais/{id}) ----------
    // Apagar um grupo marca-o como apagado: como o documento continua a existir, ninguém o recria para ler
    // as mensagens antigas. A tarefa limpeza.mjs apaga depois as mensagens e o documento.
    // O id do grupo é o código de convite: ninguém lista grupos de que não faz parte, e só quem tem o código os abre.
    match /grupos/{id} {
      allow get: if conta() || (signed() && resource.data.get(['membros', request.auth.uid], false) == true);
      allow list: if isAdmin() || (signed() && resource.data.get(['membros', request.auth.uid], false) == true);
      allow create: if ativo()
        && id.matches('^g_[A-Za-z0-9]{12,30}$')
        && d().keys().hasOnly(['nome', 'dono', 'membros', 'ts'])
        && d().keys().hasAll(['nome', 'dono', 'membros', 'ts'])
        && d().dono == request.auth.uid
        && isStr(d().nome, 3, 30)
        && d().membros is map && d().membros.size() == 1 && d().membros[request.auth.uid] == true
        && d().ts == request.time
        && ritmo('ultimoPost', 10);
      // Entrar ou sair: cada um só mexe em si próprio; no máximo 50 membros. Sair não depende da conta estar ativa.
      allow update: if (signed() && old().get('apagado', false) == false
          && d().diff(old()).affectedKeys().hasOnly(['membros'])
          && d().membros is map && d().membros.size() <= 50
          && d().membros.diff(old().membros).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in d().membros) || (ativo() && d().membros[request.auth.uid] == true
            && !(request.auth.uid in old().get('expulsos', {})))))
        // O dono pode tirar alguém do grupo e pô-lo na lista de expulsos (deixa de poder voltar com o código),
        // ou tirar alguém da lista para o deixar voltar. Não pode acrescentar membros nem expulsar-se a si próprio.
        || (ativo() && old().dono == request.auth.uid && old().get('apagado', false) == false
          && d().diff(old()).affectedKeys().hasOnly(['membros', 'expulsos'])
          && d().membros.diff(old().membros).addedKeys().size() == 0
          && d().membros.diff(old().membros).changedKeys().size() == 0
          && d().get('expulsos', {}) is map && d().get('expulsos', {}).size() <= 200
          && !(request.auth.uid in d().get('expulsos', {}))
          && d().get('expulsos', {}).diff(old().get('expulsos', {})).changedKeys().size() == 0)
        || (signed() && old().dono == request.auth.uid
          && d().diff(old()).affectedKeys().hasOnly(['apagado', 'membros'])
          && d().apagado == true && d().membros.size() == 0);
      allow delete: if isAdmin();
    }

    // ---------- Duelos 1 contra 1 ----------
    // a desafia b; os dois resolvem os mesmos exercícios (mesma semente) e cada um escreve só o seu resultado.
    match /duelos/{id} {
      allow read: if signed() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid || isAdmin());
      allow create: if ativo()
        && d().keys().hasOnly(['a', 'b', 'nA', 'nB', 'seed', 'estado', 'ra', 'rb', 'ts'])
        && d().keys().hasAll(['a', 'b', 'nA', 'nB', 'seed', 'estado', 'ra', 'rb', 'ts'])
        && d().a == request.auth.uid && uidStr(d().b) && d().b != d().a
        && isStr(d().nA, 1, 30) && isStr(d().nB, 1, 30)
        && isInt(d().seed, 1, 2000000000)
        && d().estado == 'pendente' && d().ra == -1 && d().rb == -1
        && d().ts == request.time
        && ritmo('ultimoPost', 10);
      allow update: if signed() && (
           (old().b == request.auth.uid && old().estado == 'pendente'
            && d().diff(old()).affectedKeys().hasOnly(['estado'])
            && (d().estado == 'recusado' || (d().estado == 'aceite' && ativo())))
        || (ativo() && old().a == request.auth.uid && old().ra == -1 && old().estado in ['pendente', 'aceite']
            && d().diff(old()).affectedKeys().hasOnly(['ra']) && isInt(d().ra, 0, 5))
        || (ativo() && old().b == request.auth.uid && old().rb == -1 && old().estado == 'aceite'
            && d().diff(old()).affectedKeys().hasOnly(['rb']) && isInt(d().rb, 0, 5)));
      allow delete: if signed() && (old().a == request.auth.uid || old().b == request.auth.uid || isAdmin());
    }

    // ---------- Salas "estudar juntos" (temporizador partilhado) ----------
    match /salas/{id} {
      allow read: if conta() || (signed() && resource.data.dono == request.auth.uid);
      allow create: if ativo()
        && d().keys().hasOnly(['nome', 'dono', 'membros', 'fim', 'min', 'ts'])
        && d().keys().hasAll(['nome', 'dono', 'membros', 'fim', 'min', 'ts'])
        && d().dono == request.auth.uid && isStr(d().nome, 3, 30)
        && d().membros is map && d().membros.size() == 1 && d().membros[request.auth.uid] is int
        && isInt(d().min, 5, 90) && d().fim is int && d().ts == request.time
        && ritmo('ultimoPost', 10);
      allow update: if (signed() && d().diff(old()).affectedKeys().hasOnly(['membros']) && d().membros is map && d().membros.size() <= 30
            && d().membros.diff(old().membros).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in d().membros) || (ativo() && d().membros[request.auth.uid] is int)))
        || (ativo() && old().dono == request.auth.uid && d().diff(old()).affectedKeys().hasOnly(['fim', 'min'])
            && d().fim is int && isInt(d().min, 5, 90));
      allow delete: if signed() && (old().dono == request.auth.uid || isAdmin());
    }

    // ---------- Sugestões e relatórios de erros (só o administrador lê) ----------
    match /sugestoes/{id} {
      allow create: if ativo()
        && d().keys().hasOnly(['by', 'text', 'tipo', 'ver', 'ts'])
        && d().keys().hasAll(['by', 'text', 'ts'])
        && d().by == request.auth.uid
        && isStr(d().text, 3, 1000)
        && d().get('tipo', 'ideia') in ['ideia', 'erro', 'outro']
        && isStr(d().get('ver', ''), 0, 12)
        && msOk(d().ts, 1440)
        && ritmo('ultimoPost', 10);
      allow read, delete: if isAdmin() || (signed() && resource.data.by == request.auth.uid);
      allow update: if false;
    }
    // O id é uid_AAAAMMDD_n, com n de 0 a 9: cada pessoa regista no máximo 10 erros por dia.
    match /erros/{id} {
      function diaOk() {
        let hoje = request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
        let dia = int(id[id.size() - 10:id.size() - 2]);
        return dia == hoje || dia == hoje - 1;
      }
      allow create: if naoAnonimo()
        && id.matches('^' + request.auth.uid + '_[0-9]{8}_[0-9]$')
        && diaOk()
        && d().keys().hasOnly(['by', 'msg', 'stack', 'onde', 'ver', 'ua', 'ts'])
        && d().keys().hasAll(['by', 'msg', 'ts'])
        && d().by == request.auth.uid
        && isStr(d().msg, 1, 300)
        && isStr(d().get('stack', ''), 0, 2000)
        && isStr(d().get('onde', ''), 0, 60)
        && isStr(d().get('ver', ''), 0, 12)
        && isStr(d().get('ua', ''), 0, 200)
        && msOk(d().ts, 60);
      allow read, delete: if isAdmin() || (signed() && resource.data.by == request.auth.uid);
      allow update: if false;
    }

    // ---------- Denúncias ----------
    match /denuncias/{id} {
      allow create: if ativo()
        && d().by == request.auth.uid
        && isStr(d().get('text', ''), 0, 500)
        && msOk(d().ts, 1440)
        && motivoOk()
        && (denunciaPost() || denunciaMsg());
      allow read, delete: if isAdmin();
      allow update: if false;

      function motivoOk() {
        return ('motivo' in d() && d().motivo in ['spam', 'ofensivo', 'assedio', 'improprio', 'dados_pessoais', 'outro'])
          || (legado() && !('motivo' in d()));
      }
      // O autor indicado tem de ser o autor real do conteúdo, e o conteúdo tem de existir.
      function denunciaPost() {
        return d().keys().hasOnly(['by', 'tipo', 'post', 'autor', 'text', 'ts', 'motivo'])
          && d().get('tipo', '') == 'post'
          && idStr(d().post)
          && exists(/databases/$(database)/documents/posts/$(d().post))
          && get(/databases/$(database)/documents/posts/$(d().post)).data.uid == d().autor;
      }
      function denunciaMsg() {
        return d().keys().hasOnly(['by', 'tipo', 'canal', 'msg', 'autor', 'text', 'ts', 'motivo'])
          && d().get('tipo', 'msg') == 'msg'
          && (d().canal in ['geral', 'matematica', 'testes', 'sugestoes'] || d().canal.matches('^g_[A-Za-z0-9]{6,30}$'))
          && idStr(d().msg)
          && exists(/databases/$(database)/documents/canais/$(d().canal)/msgs/$(d().msg))
          && get(/databases/$(database)/documents/canais/$(d().canal)/msgs/$(d().msg)).data.uid == d().autor;
      }
    }
  }
}
